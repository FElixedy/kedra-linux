# Maintainer: Kedra Linux
#
# Kedra's PGP trust root. Modelled on archlinux-keyring / cachyos-keyring and
# deliberately additive: it neither replaces nor conflicts with them. A Kedra
# system carries archlinux-keyring + cachyos-keyring + kedra-keyring.

pkgname=kedra-keyring
pkgver=2026.08.14
pkgrel=1
pkgdesc='Kedra Linux PGP keyring'
arch=('any')
license=('GPL-3.0-or-later')
groups=('kedra')
# pacman-key is what the scriptlet calls to import the keyring.
depends=('pacman')
install="${pkgname}.install"
# url= is intentionally unset until the Kedra upstream repository location is
# decided (same convention as kedra-hooks).

# Public material only, generated by kedra-repo's `kedra-dev-keys-init`
# (development) or by the production signing process. No secret key material is
# ever placed in this directory.
source=('kedra.gpg'
        'kedra-trusted'
        'kedra-revoked')
# The keyring is regenerated whenever keys are added, rotated or revoked, so
# pinning checksums here would only mean editing two files instead of one.
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
  install -Dm644 kedra.gpg     "$pkgdir/usr/share/pacman/keyrings/kedra.gpg"
  install -Dm644 kedra-trusted "$pkgdir/usr/share/pacman/keyrings/kedra-trusted"
  install -Dm644 kedra-revoked "$pkgdir/usr/share/pacman/keyrings/kedra-revoked"
}
