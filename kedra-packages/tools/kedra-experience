#!/usr/bin/env python3
"""Run the SHIPPED Kedra Experience command straight from this checkout.

Repository convenience only. It exists so `kedra-experience` can be exercised
from tests and by hand without installing a package, and it differs from the
installed program in exactly one way: where `kedra_experience` is imported from.
The installed entry point is kedra-experience-runtime/bin/kedra-experience,
which inserts /usr/lib/kedra/experience instead.

Both then call the same `prodcli.main`, and neither changes the default data
directory -- so running this without `--data-dir` reads
/usr/share/kedra/experience just as the installed command does.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from kedra_experience.prodcli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
