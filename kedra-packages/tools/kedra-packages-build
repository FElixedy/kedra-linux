#!/usr/bin/env bash
#
# kedra-packages-build -- build every Kedra Experience package, cleanly.
#
#   tools/kedra-packages-build [PKGNAME...]
#
# Repository infrastructure. It exists so "build all Experience packages from a
# clean environment" is one reviewable command rather than four remembered ones.
#
# CLEAN, AND WHAT THAT MEANS HERE
#
# Every package in this repository is `arch=any` and nothing is compiled: the
# payloads are TOML, Python and a generated GKeyFile. So the failure mode that
# forced kedra-calamares into a full unshare(1) build root -- a CachyOS host's
# `-march=native` producing a binary that SIGILLs on older CPUs -- cannot arise,
# and there is no artifact to disassemble afterwards. What "clean" has to mean
# instead is that no state from a previous build can reach the next one, so:
#
#   * BUILDDIR and PKGDEST are outside the source tree,
#   * `makepkg -C` empties $srcdir before each build,
#   * the working tree is required to be clean, because the payload is generated
#     from tracked files and an uncommitted edit would ship unreviewed,
#   * `makepkg --check` is forced on: the version-consistency assertion and the
#     964-test suite are check() steps, and skipping them is the whole risk.
#
# WHY makepkg RUNS WITH -d, AND WHAT REPLACES IT
#
# `kedra-experience-runtime` depends on `kedra-experience`, and
# `kedra-experience-desktop`/`-workflow` depend on GNOME schema packages. Those
# are TARGET dependencies: nothing in any build needs them present, and
# `kedra-experience` is not installed on a build host at all, so makepkg's
# runtime-dependency check refuses to start.
#
# The obvious escapes are both wrong. `--syncdeps` needs root and permanently
# changes the machine -- a trade this workstream has refused before. Installing
# the sibling package by hand means every build runs against whatever stale copy
# happens to be on the developer's system.
#
# So `depends` checking is turned off and the half that genuinely matters is
# done here instead: makedepends and checkdepends are read out of .SRCINFO and
# verified with `pacman -T` before makepkg is invoked. That half matters because
# kedra-experience lists gnome-console, gtk4, python-gobject and
# gnome-settings-daemon as checkdepends precisely so the build EXERCISES the
# tests that need them -- without them those tests skip themselves, and a build
# that skipped them would not have tested the adapter it shipped.
#
# `--check` is likewise forced on: the version-consistency assertion and the
# whole test suite are check() steps, and skipping them is the entire risk.

set -uo pipefail

REPO_ROOT=$(readlink -f "$(dirname "$(readlink -f "$0")")/..")

# Deliberately the same staging directory kedra-repo publishes from, so
# `kedra-repo-publish "$KEDRA_STAGING_DIR"/kedra-experience*.pkg.tar.zst` is the
# next command and nothing has to be copied between the two.
PKGDEST=${KEDRA_STAGING_DIR:-${HOME}/Build/kedra-staging}
BUILDDIR=${KEDRA_BUILDDIR:-${HOME}/Build/kedra-packages-build}

# Build order is not arbitrary. kedra-experience installs the manifests the
# other three are generated from or resolve against, so building it first means
# a manifest error is reported once, by the package that owns it.
ALL_PACKAGES=(
	kedra-experience
	kedra-experience-runtime
	kedra-experience-desktop
	kedra-experience-workflow
)

msg()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> WARNING:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

packages=("$@")
(( ${#packages[@]} )) || packages=("${ALL_PACKAGES[@]}")

command -v makepkg >/dev/null || die "makepkg is not installed"

# A generated payload built from an uncommitted edit is a package that
# corresponds to no commit anyone can point at.
if [[ -n $(git -C "${REPO_ROOT}" status --porcelain 2>/dev/null) ]]; then
	warn "the working tree is dirty; built packages will not correspond to a commit"
	git -C "${REPO_ROOT}" status --short >&2
fi

install -d "${PKGDEST}" "${BUILDDIR}"

built=()
for pkg in "${packages[@]}"; do
	dir="${REPO_ROOT}/${pkg}"
	[[ -f ${dir}/PKGBUILD ]] || die "no PKGBUILD for '${pkg}'"

	msg "building ${pkg}"

	# The build-time half of dependency checking, done here because makepkg's
	# is turned off below. Unsatisfied entries are printed by pacman -T.
	mapfile -t builddeps < <(
		( cd "${dir}" && makepkg --printsrcinfo 2>/dev/null ) |
			sed -n 's/^[[:space:]]*\(makedepends\|checkdepends\)[[:space:]]*=[[:space:]]*//p' |
			sed 's/[<>=].*//' | sort -u
	)
	if (( ${#builddeps[@]} )); then
		missing=$(pacman -T -- "${builddeps[@]}") || true
		[[ -z ${missing} ]] ||
			die "${pkg}: missing build/check dependencies: ${missing//$'\n'/ }"
	fi

	(
		cd "${dir}" || exit 1
		# -C empties $srcdir first. -f overwrites an existing artifact in
		# PKGDEST, which is safe because PKGDEST is staging, not the published
		# repository -- kedra-repo-publish is what decides whether a version may
		# enter [kedra]. -d skips runtime-dependency resolution; see the note at
		# the top of this file for what is done instead.
		PKGDEST="${PKGDEST}" BUILDDIR="${BUILDDIR}" \
			makepkg -Cf --check --noconfirm -d
	) || die "${pkg} failed to build"

	built+=("${pkg}")
done

msg "built ${#built[@]} package(s) into ${PKGDEST}"
for pkg in "${built[@]}"; do
	# The exact filenames, so the publish command can be copied off the screen.
	find "${PKGDEST}" -maxdepth 1 -name "${pkg}-[0-9]*.pkg.tar.*" ! -name '*.sig' \
		-newermt '-1 hour' -printf '    %f\n'
done

cat <<NOTE

Next:
  # verify the packaged layout with no source checkout reachable
  KEDRA_PKGDEST=${PKGDEST} python3 -m unittest discover -s ${REPO_ROOT}/tests

  # sign and publish into [kedra]
  ../kedra/kedra-repo/bin/kedra-repo-publish ${PKGDEST}/<file>.pkg.tar.zst
NOTE
